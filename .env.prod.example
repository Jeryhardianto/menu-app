# Template .env.prod. Berkas aslinya HANYA ada di VM (/home/vm-gpu/menu-app/.env.prod,
# chmod 600) — tidak pernah di-rsync, tidak pernah di-commit.
# Dipakai dua kali: `env_file:` service app (Laravel baca sebagai env var asli),
# dan `--env-file` compose untuk ${DB_*} di service db.

APP_NAME="Vanjava Plus"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://menu.blataktech.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# DB_HOST=db -> service `db` di compose.prod.yaml, bukan host luar.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=menu_app
DB_USERNAME=menu_app
DB_PASSWORD=
# Hanya untuk compose (MARIADB_ROOT_PASSWORD); Laravel tidak memakainya.
DB_ROOT_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Upload disimpan lokal di volume `storage`, bukan MinIO. Lihat helper image_url().
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
